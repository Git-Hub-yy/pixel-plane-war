# ═══════════════════════════════════════════════════════════
#  PixelPlaneWar · .gitattributes
# ═══════════════════════════════════════════════════════════

# ────────── 换行符规范 ──────────
* text=auto

*.cs       text diff=csharp
*.shader   text diff=text
*.json     text
*.xml      text
*.md       text
*.txt      text

# ────────── Unity 资源文件（YAML）──────────
*.unity    text
*.prefab   text
*.asset    text
*.mat      text
*.controller text
*.anim     text
*.meta     text

# ────────── 音频（Unity 专用音频资源也是 YAML）──────────
*.mixer    text

# ────────── 二进制资源 ──────────
*.png      binary
*.jpg      binary
*.jpeg     binary
*.psd      binary
*.ttf      binary
*.TTC      binary
*.otf      binary
*.fbx      binary
*.obj      binary
*.wav      binary
*.mp3      binary
*.ogg      binary
*.dll      binary
*.so       binary
*.apk      binary
*.aab      binary
*.unitypackage binary